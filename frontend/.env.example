# Mirai hub settings. Every variable is optional; the value shown is the default when it is unset or blank.
# On a deployed host put overrides in ~/.config/mirai/hub.env (read by the systemd unit, never deployed).
# For a dev run on this machine, copy to .env (Bun loads it automatically). src/hub/config.ts is the source of
# truth; a test fails if this file and it disagree on the list of variables.

# server
MIRAI_HUB_HOST=127.0.0.1
PORT=3131
MIRAI_DB=data/mirai.db
TAILSCALE_BIN=tailscale
MIRAI_AGENT_PORT=7070

# fleet polling (ms): fast while someone has the UI open, slow otherwise
MIRAI_VITALS_WATCHED_MS=2000
MIRAI_VITALS_IDLE_MS=15000
MIRAI_DISCOVERY_WATCHED_MS=10000
MIRAI_DISCOVERY_IDLE_MS=30000
MIRAI_PINGS_WATCHED_MS=30000
MIRAI_PINGS_IDLE_MS=300000
MIRAI_DETAIL_MS=3000
MIRAI_AGENT_TIMEOUT_MS=1500
MIRAI_KILL_TIMEOUT_MS=5000
# consecutive missed polls before a machine shows "no agent"
MIRAI_AGENT_MAX_FAILURES=3

# fleet history and alerts
MIRAI_HISTORY_DAYS=7
# the same event for the same machine is recorded at most once per this window
MIRAI_EVENT_REPEAT_MS=1800000
MIRAI_TEMP_HOT_C=80
MIRAI_DISK_FULL_PCT=85
# CPU or memory load (%) at which meters and processes turn red
MIRAI_LOAD_HOT_PCT=80
# rows a long list shows at first and adds on scroll
MIRAI_LIST_PAGE_SIZE=10
# how many recent fleet events the events list shows
MIRAI_EVENTS_SHOWN=12

# tasks: local daily notes. The folder and file name format come from the vault's .obsidian/daily-notes.json.
# No default: without it the local board says what is missing.
MIRAI_VAULT_DIR=
MIRAI_CARRY_DAYS=7
# quiet time after a file change before re-reading notes (Syncthing writes in bursts)
MIRAI_NOTES_SETTLE_MS=150

# tasks: Linear and GitHub
LINEAR_API_KEY=
LINEAR_API_URL=https://api.linear.app/graphql
# falls back to `gh auth token` when unset
GITHUB_TOKEN=
GITHUB_GRAPHQL_URL=https://api.github.com/graphql
# GitHub login of Linear's GitHub integration; its issues are marked as mirrored from Linear
MIRAI_LINEAR_GITHUB_BOT=linear
# how long finished Linear issues and closed GitHub issues stay on the boards
MIRAI_TASKS_DONE_DAYS=14
MIRAI_TASKS_POLL_MS=60000
# when a polled board's freshness dot turns amber
MIRAI_TASKS_STALE_AFTER_MS=180000
# after this long the hub still answers at once with what it has, and refreshes from upstream behind it
MIRAI_TASKS_CACHE_MS=30000
# how soon the browser asks again after the hub answered with data older than the cache window
MIRAI_TASKS_CATCHUP_MS=3000
MIRAI_TASKS_MAX_PAGES=20
MIRAI_TASKS_TIMEOUT_MS=15000

# tasks: priority ranking across all three boards, by Jev (a typed decision model) through OpenRouter.
# No default key: without it the priority section says what is missing.
OPENROUTER_API_KEY=
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
MIRAI_PRIORITY_MODEL=~typesafe/jev-latest
# who the ranking is for; Jev weighs return on investment against this
MIRAI_PRIORITY_PROFILE=A software engineer
# items per Jev request (requests run in parallel) and how many the section shows
MIRAI_PRIORITY_BATCH=25
MIRAI_PRIORITY_SHOWN=8

# ship: open pull requests in one GitHub org. Uses the GitHub token and the cache, page and timeout limits above.
# No default: without it the ship view says what is missing.
MIRAI_SHIP_ORG=
# how many matches a search across the org returns
MIRAI_SHIP_SEARCH_SIZE=30
# how often an open PR preview re-reads its description; GitHub's signed image and video links expire after 5 minutes
MIRAI_SHIP_BODY_REFRESH_MS=240000

# later: saved articles and videos. Reading time uses words per minute; pages are fetched once when saved.
MIRAI_LATER_WPM=230
MIRAI_LATER_FETCH_TIMEOUT_MS=10000
# unread items older than this are offered for archiving
MIRAI_LATER_STALE_DAYS=30
# how often the browser saves reading or watching progress
MIRAI_LATER_SAVE_EVERY_MS=3000
# your reddit_session browser cookie, so saved reddit threads open with their full comments; tweets need nothing
MIRAI_REDDIT_SESSION=
# yt-dlp, used to list the videos of a pasted YouTube playlist so each one is saved on its own
MIRAI_YTDLP_BIN=yt-dlp
# subtitles for saved YouTube videos, transcribed on this machine; deploy/asr/setup.sh installs the transcriber and sets the path, blank turns transcripts off
MIRAI_ASR_BIN=
# how often the hub looks for videos to transcribe, and how long one transcription may take
MIRAI_ASR_POLL_MS=30000
MIRAI_ASR_TIMEOUT_MS=3600000
# a failed transcription is retried this many times in total, waiting 5 min, then 30 min (each wait is 6x the last)
MIRAI_ASR_MAX_ATTEMPTS=3
MIRAI_ASR_RETRY_MS=300000

# syntax highlighting in PR review: the hub keeps a bare, blob-less clone of each repository here and reads files from it; blank means ~/.cache/mirai/code.
# keep it outside this project, or `bun test src` and tsc would pick up the cloned repositories
MIRAI_CODE_DIR=
# where repositories are cloned from; the GitHub token authenticates it
MIRAI_CODE_GIT_URL=https://github.com
# the Rust highlighter built from ../code (deploy/build-code.sh locally, install-hub.sh on the hub); blank means bin/mirai-code-<os>-<arch>
MIRAI_CODE_BIN=
MIRAI_CODE_TIMEOUT_MS=60000
# files larger than this are shown without colours
MIRAI_CODE_MAX_BYTES=1000000

# px0 (https://github.com/px0-ai/px0): "open in px0" on a pull request starts `px0 <pr url>` on the hub in a worktree of the clone above and serves it at /px0/<repo>-<number>/.
# install-hub.sh downloads the pinned release; blank means bin/px0-<os>-<arch>
MIRAI_PX0_BIN=
# at most this many px0 instances run at once; opening another stops the least recently used
MIRAI_PX0_MAX=4
# an instance with no open tab and no requests for this long is stopped
MIRAI_PX0_IDLE_MS=1800000
# the first open of a repository fetches the pull request and checks it out, which can take a while on a big repository
MIRAI_PX0_READY_TIMEOUT_MS=180000

# stats: Claude Code and Codex usage. Each machine's agent scans its own session logs and reads plan limits with its own logins;
# the hub polls them, keeps the last good copy per machine in the stats dir, and prices tokens with the LiteLLM table.
MIRAI_STATS_DIR=data/stats
MIRAI_STATS_USAGE_POLL_MS=300000
MIRAI_STATS_LIMITS_POLL_MS=180000
MIRAI_STATS_USAGE_TIMEOUT_MS=30000
MIRAI_STATS_LIMITS_TIMEOUT_MS=15000
# limits from an account not seen for this long after the newest reading of the same provider are dropped
MIRAI_STATS_STALE_ACCOUNT_MS=86400000
MIRAI_PRICES_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
MIRAI_PRICES_TTL_MS=86400000

# projects: the hub polls agents for worktrees, listeners and containers only while someone looked at /projects within this long
MIRAI_PROJECTS_IDLE_MS=120000
# an agent that was idle rescans before answering, which takes a few seconds on a machine with many worktrees
MIRAI_PROJECTS_FETCH_TIMEOUT_MS=12000

# mirAI: the assistant in the right panel. pi runs inside the hub with its own shell and file tools plus Mirai's snapshot tools, unrestricted as the hub user; without a key the panel says mirAI is off.
OPENAI_API_KEY=
# an openai/<model> id as pi names it; `pi --list-models openai` lists what the installed pi knows
MIRAI_CHAT_MODEL=openai/gpt-6-luna
# off, minimal, low, medium, high, xhigh or max
MIRAI_CHAT_THINKING=medium
# threads are pi session files under <dir>/threads; install-hub.sh never syncs data/, so they survive deploys
MIRAI_CHAT_DIR=data/mirai
# a thread nobody asked in for this long is unloaded from memory; its file stays and it resumes on the next question
MIRAI_CHAT_IDLE_MS=600000
# the llm-wiki mirAI reads and writes; blank means ~/Documents/llm-wiki
MIRAI_WIKI_DIR=
# the name mirAI uses for you in its instructions
MIRAI_OWNER=the user
